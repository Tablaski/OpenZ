<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <NoWarn>CS0649</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../source/Assets/OpenZ/Scripts/Multiplayer/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../../OpenZ_1.4_source/Assets/OpenZ/Scripts/Sim/*.cs" Link="Simulation/%(Filename)%(Extension)" />
    <Compile Include="../../source/Assets/OpenZ/Scripts/Multiplayer/Simulation/*.cs" Link="Adapter/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
